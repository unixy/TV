//@version=6
indicator(shorttitle="BB DThresh", title="Bollinger Bands Diff Threshold", overlay=true)

TT_LENGTH  = "The time period to be used in calculating the MA which creates the base for the Upper and Lower Bands."
TT_MA_TYPE = "Determines the type of Moving Average that is applied to the basis plot line."
TT_SOURCE  = "Determines what data from each bar will be used in calculations."
TT_MULT    = "The number of Standard Deviations away from the MA that the Upper and Lower Bands should be."
TT_OFFSET  = "Changing this number will move the Bollinger Bands either Forwards or Backwards relative to the current market."
DIFF_THRESHOLD = "This nob is a threshold determines the tightest possible bands in Bollinger's"

length = input.int(20,       "Length", minval = 1, tooltip =  TT_LENGTH)
maType = input.string("SMA", "Basis MA Type",      options = ["SMA", "EMA", "SMMA (RMA)", "WMA", "VWMA"], tooltip = TT_MA_TYPE)
src =    input(close,        "Source", tooltip = TT_SOURCE)
mult =   input.float(2.0,    "StdDev", minval = 0.001, maxval = 50,  tooltip = TT_MULT)
offset = input.int(0,        "Offset", minval = -500,  maxval = 500, tooltip =  TT_OFFSET, display = display.none)
diffThreshold = input.int(20, "Diff Threshold", minval=0, maxval=200, tooltip=DIFF_THRESHOLD)
topN         = input.int(5,  "Number of Narrow Zones to Label", minval = 1, maxval = 20)
minBarGap    = input.int(10, "Minimum Bars Between Zones", minval = 0, tooltip = "Prevents picking multiple bars from the same squeeze event.")
zoneHalfWidth = input.int(2, "Zone Box Half-Width (bars)", minval = 0)
maxCandidates = input.int(300, "Max Tracked Candidates", minval = 20, tooltip = "Caps how many narrow-band bars are tracked at once. Higher = more thorough zone spacing, at a small performance cost.")

var box[]   squeezeBoxes  = array.new<box>()
var label[] squeezeLabels = array.new<label>()

rankColor(rank) =>
    switch rank
        1 => color.new(#FFD700, 70)   // gold
        2 => color.new(#C0C0C0, 70)   // silver
        3 => color.new(#CD7F32, 70)   // bronze
        => color.new(#2196F3, 70)     // blue for the rest

rankIcon(rank) =>
    switch rank
        1 => "🥇"
        2 => "🥈"
        3 => "🥉"
        => "🔹"
        
type DiffData
    float upperBand
    float lowerBand
    float ratio
    int barIndex

insertSorted(DiffData[] arr, DiffData d, int maxSize) =>
    n = array.size(arr)
    pos = n
    if n > 0
        for i = 0 to n - 1
            if d.ratio < array.get(arr, i).ratio
                pos := i
                break
    array.insert(arr, pos, d)
    if array.size(arr) > maxSize
        array.pop(arr)   // evict the widest (worst) candidate once over capacity

var DiffData[] history = array.new<DiffData>()

ma(source, length, _type) =>
    switch _type
        "SMA" => ta.sma(source, length)
        "EMA" => ta.ema(source, length)
        "SMMA (RMA)" => ta.rma(source, length)
        "WMA" => ta.wma(source, length)
        "VWMA" => ta.vwma(source, length)

basis = ma(src, length, maType)
dev = mult * ta.stdev(src, length)
upper = basis + dev
lower = basis - dev

DiffData currentDiffData = DiffData.new(math.abs(upper), math.abs(lower), math.abs(upper)/math.abs(lower), bar_index)

if not na(currentDiffData.ratio) and barstate.isconfirmed
    insertSorted(history, currentDiffData, maxCandidates)

if barstate.islast
    for b in squeezeBoxes
        box.delete(b)
    for l in squeezeLabels
        label.delete(l)
    array.clear(squeezeBoxes)
    array.clear(squeezeLabels)

    n = array.size(history)
    DiffData[] selected = array.new<DiffData>()

    if n > 0
        for i = 0 to n - 1
            if array.size(selected) >= topN
                break
            DiffData candidate = array.get(history, i)
            tooClose = false
            for sel in selected
                if math.abs(candidate.barIndex - sel.barIndex) < minBarGap
                    tooClose := true
            if not tooClose
                array.push(selected, candidate)

    for [i, item] in selected
        rank = i + 1
        col  = rankColor(rank)
        bandWidthPct = (item.upperBand - item.lowerBand) / ((item.upperBand + item.lowerBand) / 2) * 100

        b = box.new(left = item.barIndex - zoneHalfWidth, right = item.barIndex + zoneHalfWidth,
             top = item.upperBand, bottom = item.lowerBand,
             border_color = color.new(col, 20), border_width = 2, bgcolor = col)
        array.push(squeezeBoxes, b)

        lbl = label.new(x = item.barIndex, y = item.upperBand,
             text = rankIcon(rank) + " " + str.tostring(bandWidthPct, "#.##") + "% BW\n" + str.tostring(item.upperBand - item.lowerBand, format.mintick) + " wide",
             style = label.style_label_down, color = color.new(col, 20),
             textcolor = color.white, size = size.small)
        array.push(squeezeLabels, lbl)

    for [i, item] in history
        log.info("New Rank " + str.tostring(i+1) + " -> Ratio: " + str.tostring(item.ratio) + " | Bar Index: " + str.tostring(item.barIndex) + " | Upper " + str.tostring(item.upperBand) + " | Lower " + str.tostring(item.lowerBand))

plot(basis, "Basis", color=#2962FF, offset = offset)
p1 = plot(upper, "Upper", color=#F23645, offset = offset)
p2 = plot(lower, "Lower", color=#089981, offset = offset)
fill(p1, p2, title = "Background", color=color.rgb(33, 150, 243, 95))
