//@version=6
indicator("Crypto Squeeze Screener", shorttitle = "BB Squeeze Screener", overlay = false)

TT_WATCHLIST = "Up to ~40 full TradingView tickers, comma-separated, e.g. BINANCE:BTCUSDT,BINANCE:ETHUSDT. TradingView caps the number of unique request.security() contexts a script can hold, so very long lists may hit that limit."
TT_RANK      = "A symbol is flagged as squeezed when its current BandWidth% is at or inside the N tightest readings ever seen for that symbol on the scan timeframe."

symbolsInput = input.text_area(
     "BINANCE:BTCUSDT,BINANCE:ETHUSDT,BINANCE:SOLUSDT,BINANCE:BNBUSDT,BINANCE:XRPUSDT,BINANCE:ADAUSDT,BINANCE:DOGEUSDT,BINANCE:AVAXUSDT,BINANCE:LINKUSDT,BINANCE:DOTUSDT",
     "Watchlist (comma-separated symbols)", tooltip = TT_WATCHLIST)
scanTimeframe = input.timeframe("D", "Scan Timeframe")

length         = input.int(20,   "BB Length", minval = 1)
maType         = input.string("SMA", "Basis MA Type", options = ["SMA", "EMA", "SMMA (RMA)", "WMA", "VWMA"])
mult           = input.float(2.0, "BB StdDev", minval = 0.001, maxval = 50)
topNHistorical = input.int(20,   "Historical Rank N (tightest-ever)", minval = 1, tooltip = TT_RANK)
maxCandidates  = input.int(300,  "Max Tracked Candidates", minval = 20, tooltip = "Must be >= N above.")

ma(source, len, _type) =>
    switch _type
        "SMA" => ta.sma(source, len)
        "EMA" => ta.ema(source, len)
        "SMMA (RMA)" => ta.rma(source, len)
        "WMA" => ta.wma(source, len)
        "VWMA" => ta.vwma(source, len)

type BWRecord
    float bandWidthPct
    int barIndex

type ScanResult
    string symbol
    float bandWidthPct
    float recordThreshold
    bool squeezed

insertBW(BWRecord[] arr, BWRecord d, int maxSize) =>
    n = array.size(arr)
    pos = n
    if n > 0
        for i = 0 to n - 1
            if d.bandWidthPct < array.get(arr, i).bandWidthPct
                pos := i
                break
    array.insert(arr, pos, d)
    if array.size(arr) > maxSize
        array.pop(arr)   // evict the widest (least relevant) reading once over capacity

insertResult(ScanResult[] arr, ScanResult d) =>
    n = array.size(arr)
    pos = n
    if n > 0
        for i = 0 to n - 1
            if d.bandWidthPct < array.get(arr, i).bandWidthPct
                pos := i
                break
    array.insert(arr, pos, d)

// Evaluated per-symbol inside request.security(): each unique symbol context
// keeps its own persistent `tightestEver` leaderboard across bars, exactly like
// the strategy script's own historical-rank logic.
squeezeCalc(len, _type, stdevMult, topN, maxCand) =>
    var BWRecord[] tightestEver = array.new<BWRecord>()
    basis = ma(close, len, _type)
    dev = stdevMult * ta.stdev(close, len)
    upper = basis + dev
    lower = basis - dev
    bwPct = (upper - lower) / basis * 100
    recordThreshold = array.size(tightestEver) >= topN ? array.get(tightestEver, topN - 1).bandWidthPct : na
    squeezedNow = not na(recordThreshold) and bwPct <= recordThreshold
    if not na(bwPct) and barstate.isconfirmed
        insertBW(tightestEver, BWRecord.new(bwPct, bar_index), maxCand)
    [bwPct, recordThreshold, squeezedNow]

symbols = str.split(symbolsInput, ",")

var ScanResult[] results = array.new<ScanResult>()
array.clear(results)

for i = 0 to array.size(symbols) - 1
    sym = str.trim(array.get(symbols, i))
    if str.length(sym) > 0
        [bwPct, recThresh, squeezedNow] = request.security(sym, scanTimeframe, squeezeCalc(length, maType, mult, topNHistorical, maxCandidates))
        if not na(bwPct)
            insertResult(results, ScanResult.new(sym, bwPct, recThresh, squeezedNow))

if barstate.islast
    var table screenerTable = table.new(position.top_right, 5, array.size(symbols) + 1, border_width = 1)

    table.cell(screenerTable, 0, 0, "Symbol",         bgcolor = color.gray, text_color = color.white)
    table.cell(screenerTable, 1, 0, "BandWidth %",    bgcolor = color.gray, text_color = color.white)
    table.cell(screenerTable, 2, 0, "Record (Top N)", bgcolor = color.gray, text_color = color.white)
    table.cell(screenerTable, 3, 0, "% of Record",    bgcolor = color.gray, text_color = color.white)
    table.cell(screenerTable, 4, 0, "Squeezed?",      bgcolor = color.gray, text_color = color.white)

    for [i, r] in results
        rowColor = r.squeezed ? color.new(color.green, 70) : color.new(color.gray, 90)
        pctOfRecord = na(r.recordThreshold) ? na : r.bandWidthPct / r.recordThreshold * 100

        table.cell(screenerTable, 0, i + 1, r.symbol, bgcolor = rowColor)
        table.cell(screenerTable, 1, i + 1, str.tostring(r.bandWidthPct, "#.##") + "%", bgcolor = rowColor)
        table.cell(screenerTable, 2, i + 1, na(r.recordThreshold) ? "warming up" : str.tostring(r.recordThreshold, "#.##") + "%", bgcolor = rowColor)
        table.cell(screenerTable, 3, i + 1, na(pctOfRecord) ? "-" : str.tostring(pctOfRecord, "#.#") + "%", bgcolor = rowColor)
        table.cell(screenerTable, 4, i + 1, r.squeezed ? "🔥 YES" : "-", bgcolor = rowColor)
