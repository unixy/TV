//@version=6
indicator(title = "Session Pullback 5m (SPS)", shorttitle = "SPS Indicator", overlay = true, max_labels_count = 200, max_lines_count = 200)

// ============================================================================
// Session Pullback System - see day-trading-system/PLAYBOOK.md for the full
// rule set. This script implements: 4H trend bias, session-anchored VWAP,
// fibonacci pullback zone with VWAP/EMA confluence, momentum+volume trigger,
// 4-hour session-block boundaries/countdown, and a conservative volatility
// filter. It draws signals and levels only - it does NOT place trades.
// Use Session_Pullback_5m_Strategy.pine for backtesting with sizing/exits.
// ============================================================================

// ---------------- Bias (4H) ----------------
biasTf        = input.timeframe("240", "Bias Timeframe", group = "Bias Filter")
emaFastLen    = input.int(20, "Bias EMA Fast", minval = 1, group = "Bias Filter")
emaSlowLen    = input.int(50, "Bias EMA Slow", minval = 1, group = "Bias Filter")
minSepAtrMult = input.float(0.15, "Min EMA Separation (x 4H ATR)", minval = 0.0, step = 0.05,
     tooltip = "Chop filter. If the fast/slow EMA spread on the bias timeframe is smaller than this many 4H ATRs, bias is treated as neutral (no trades).", group = "Bias Filter")

// ---------------- Setup ----------------
pivotLen         = input.int(3, "Pivot Lookback (bars each side)", minval = 1, group = "Setup")
fib382           = input.float(0.382, "Fib Zone Near Edge", minval = 0.0, maxval = 1.0, group = "Setup")
fib618           = input.float(0.618, "Fib Zone Far Edge", minval = 0.0, maxval = 1.0, group = "Setup")
zoneTouchWindow  = input.int(6, "Zone Touch Validity (bars)", minval = 1, tooltip = "How many bars after price touches the fib zone the trigger stays valid.", group = "Setup")
ema21Len         = input.int(21, "Confluence EMA", minval = 1, group = "Setup")
confluenceAtrMul = input.float(0.5, "Confluence Tolerance (x 5m ATR)", minval = 0.05, step = 0.05,
     tooltip = "Close must be within this many 5-minute ATRs of session VWAP or the confluence EMA for the pullback to count as 'confluent'.", group = "Setup")

// ---------------- Trigger ----------------
rsiLen      = input.int(14, "RSI Length", minval = 1, group = "Trigger")
rsiTrigger  = input.float(45, "RSI Reclaim Level", minval = 1, maxval = 99, group = "Trigger")
volMaLen    = input.int(20, "Volume MA Length", minval = 1, group = "Trigger")

// ---------------- Session Block ----------------
sessionStartHour = input.int(9, "Block Anchor Hour (0-23)", minval = 0, maxval = 23, group = "Session Block")
sessionStartMin  = input.int(30, "Block Anchor Minute", minval = 0, maxval = 55, step = 5, group = "Session Block")
sessionTz        = input.string(syminfo.timezone, "Session Timezone", tooltip = "e.g. America/New_York, UTC, Etc/UTC. Defaults to the instrument's exchange timezone.", group = "Session Block")
blockLenMin       = 240
noTradeOpenMin    = input.int(10, "No New Entries: First N Minutes of Block", minval = 0, group = "Session Block")
noTradeCloseMin   = input.int(20, "No New Entries: Last N Minutes of Block", minval = 0, group = "Session Block")

// ---------------- Volatility Filter ----------------
atrLen        = input.int(14, "ATR Length (5m)", minval = 1, group = "Volatility Filter")
pctLookback   = input.int(1000, "ATR% Percentile Lookback (bars)", minval = 50,
     tooltip = "~20 trading days on a regular-hours 5m equity chart is roughly 1500-1600 bars; adjust for 24/7 or extended-hours markets.", group = "Volatility Filter")
lowPctile     = input.float(10, "Skip Below This Percentile (dead market)", minval = 0, maxval = 100, group = "Volatility Filter")
highPctile    = input.float(97.5, "Skip Above This Percentile (event/abnormal vol)", minval = 0, maxval = 100, group = "Volatility Filter")

// ============================================================================
// Bias
// ============================================================================
[biasEmaFast, biasEmaSlow, biasAtr, biasClose] = request.security(syminfo.tickerid, biasTf,
     [ta.ema(close, emaFastLen), ta.ema(close, emaSlowLen), ta.atr(14), close], lookahead = barmerge.lookahead_off)

emaSepAtr   = biasAtr != 0 ? (biasEmaFast - biasEmaSlow) / biasAtr : na
biasBullish = biasEmaFast > biasEmaSlow and biasClose > biasEmaFast and emaSepAtr > minSepAtrMult
biasBearish = biasEmaFast < biasEmaSlow and biasClose < biasEmaFast and emaSepAtr < -minSepAtrMult
biasLabel   = biasBullish ? "BULLISH" : biasBearish ? "BEARISH" : "NEUTRAL (no trade)"

// ============================================================================
// Session block bookkeeping
// ============================================================================
hNow = hour(time, sessionTz)
mNow = minute(time, sessionTz)
minutesSinceAnchor0 = (hNow * 60 + mNow) - (sessionStartHour * 60 + sessionStartMin)
minutesSinceAnchor  = minutesSinceAnchor0 < 0 ? minutesSinceAnchor0 + 1440 : minutesSinceAnchor0
posInBlock  = minutesSinceAnchor % blockLenMin
newBlock    = posInBlock == 0
minutesLeft = blockLenMin - posInBlock

noTradeWindow = posInBlock < noTradeOpenMin or posInBlock >= (blockLenMin - noTradeCloseMin)

var int signalsThisBlock = 0
if newBlock
    signalsThisBlock := 0

// ============================================================================
// Session VWAP (resets each 4h block)
// ============================================================================
var float cumPV  = 0.0
var float cumVol = 0.0
if newBlock
    cumPV  := 0.0
    cumVol := 0.0
cumPV  += hlc3 * volume
cumVol += volume
vwapSession = cumVol > 0 ? cumPV / cumVol : na

emaConfluence = ta.ema(close, ema21Len)
atr5 = ta.atr(atrLen)

// ============================================================================
// Volatility filter
// ============================================================================
atrPct = atr5 / close * 100
volPercentile = ta.percentrank(atrPct, pctLookback)
volOk = volPercentile >= lowPctile and volPercentile <= highPctile

// ============================================================================
// Pivot-based impulse leg tracking
// ============================================================================
pivHigh = ta.pivothigh(pivotLen, pivotLen)
pivLow  = ta.pivotlow(pivotLen, pivotLen)

var float lastPivLowPrice  = na
var int   lastPivLowBar    = na
var float lastPivHighPrice = na
var int   lastPivHighBar   = na
var float runUpHigh   = na
var float runDownLow  = na

if not na(pivLow)
    lastPivLowPrice := pivLow
    lastPivLowBar   := bar_index - pivotLen
    runUpHigh       := ta.highest(high, pivotLen + 1)
else
    runUpHigh := math.max(nz(runUpHigh, high), high)

if not na(pivHigh)
    lastPivHighPrice := pivHigh
    lastPivHighBar   := bar_index - pivotLen
    runDownLow       := ta.lowest(low, pivotLen + 1)
else
    runDownLow := math.min(nz(runDownLow, low), low)

legUpValid   = not na(lastPivLowPrice) and not na(runUpHigh) and runUpHigh > lastPivLowPrice
legDownValid = not na(lastPivHighPrice) and not na(runDownLow) and lastPivHighPrice > runDownLow

fibZoneLongHi = legUpValid ? runUpHigh - (runUpHigh - lastPivLowPrice) * fib382 : na
fibZoneLongLo = legUpValid ? runUpHigh - (runUpHigh - lastPivLowPrice) * fib618 : na
fibZoneShortLo = legDownValid ? runDownLow + (lastPivHighPrice - runDownLow) * fib382 : na
fibZoneShortHi = legDownValid ? runDownLow + (lastPivHighPrice - runDownLow) * fib618 : na

touchedLongZone  = legUpValid and low <= fibZoneLongHi and low >= fibZoneLongLo
touchedShortZone = legDownValid and high >= fibZoneShortLo and high <= fibZoneShortHi
barsSinceLongTouch  = ta.barssince(touchedLongZone)
barsSinceShortTouch = ta.barssince(touchedShortZone)
longZoneFresh  = not na(barsSinceLongTouch) and barsSinceLongTouch <= zoneTouchWindow
shortZoneFresh = not na(barsSinceShortTouch) and barsSinceShortTouch <= zoneTouchWindow

confluenceLong  = not na(vwapSession) and (math.abs(close - vwapSession) <= atr5 * confluenceAtrMul or math.abs(close - emaConfluence) <= atr5 * confluenceAtrMul)
confluenceShort = confluenceLong

// ============================================================================
// Trigger
// ============================================================================
rsiVal = ta.rsi(close, rsiLen)
volMa  = ta.sma(volume, volMaLen)

rsiReclaimUp   = ta.crossover(rsiVal, rsiTrigger)
rsiReclaimDown = ta.crossunder(rsiVal, 100 - rsiTrigger)
volOkBar = volume >= volMa

longTrigger = biasBullish and legUpValid and longZoneFresh and confluenceLong and not noTradeWindow and volOk and
     close > fibZoneLongLo and close > open and rsiReclaimUp and volOkBar

shortTrigger = biasBearish and legDownValid and shortZoneFresh and confluenceShort and not noTradeWindow and volOk and
     close < fibZoneShortHi and close < open and rsiReclaimDown and volOkBar

// Structure + volatility stop, per PLAYBOOK.md section 7
structStopLong  = legUpValid ? lastPivLowPrice - atr5 * 0.1 : na
volStopLong     = close - atr5 * 1.5
rawStopLong     = math.max(structStopLong, volStopLong)
minStopLong     = close - atr5 * 1.0
stopLong        = math.min(rawStopLong, minStopLong)
stopDistLong    = close - stopLong
targetLong      = close + stopDistLong * 2.0

structStopShort = legDownValid ? lastPivHighPrice + atr5 * 0.1 : na
volStopShort    = close + atr5 * 1.5
rawStopShort    = math.min(structStopShort, volStopShort)
minStopShort    = close + atr5 * 1.0
stopShort       = math.max(rawStopShort, minStopShort)
stopDistShort   = stopShort - close
targetShort     = close - stopDistShort * 2.0

if longTrigger or shortTrigger
    signalsThisBlock += 1

// ============================================================================
// Plotting
// ============================================================================
plot(vwapSession, "Session VWAP", color = #FF6D00, linewidth = 2)
plot(emaConfluence, "Confluence EMA", color = #2962FF)
plotFibHi = plot(legUpValid ? fibZoneLongHi : na, "Long Fib Zone Hi", color = color.new(color.teal, 60), display = display.pane)
plotFibLo = plot(legUpValid ? fibZoneLongLo : na, "Long Fib Zone Lo", color = color.new(color.teal, 60), display = display.pane)
fill(plotFibHi, plotFibLo, color = color.new(color.teal, 85), title = "Long Fib Zone")
plotFibHiS = plot(legDownValid ? fibZoneShortHi : na, "Short Fib Zone Hi", color = color.new(color.maroon, 60), display = display.pane)
plotFibLoS = plot(legDownValid ? fibZoneShortLo : na, "Short Fib Zone Lo", color = color.new(color.maroon, 60), display = display.pane)
fill(plotFibHiS, plotFibLoS, color = color.new(color.maroon, 85), title = "Short Fib Zone")

bgcolor(newBlock ? color.new(color.gray, 60) : na, title = "Session Block Boundary")
bgcolor(not volOk ? color.new(color.orange, 92) : na, title = "Volatility Filter Blocking")

plotshape(longTrigger, "Long Signal", style = shape.triangleup, location = location.belowbar, color = color.green, size = size.small)
plotshape(shortTrigger, "Short Signal", style = shape.triangledown, location = location.abovebar, color = color.red, size = size.small)

if longTrigger
    label.new(bar_index, low - atr5, "LONG\nE " + str.tostring(close, format.mintick) + "\nSL " + str.tostring(stopLong, format.mintick) + "\nTP " + str.tostring(targetLong, format.mintick),
         style = label.style_label_up, color = color.new(color.green, 20), textcolor = color.white, size = size.small)

if shortTrigger
    label.new(bar_index, high + atr5, "SHORT\nE " + str.tostring(close, format.mintick) + "\nSL " + str.tostring(stopShort, format.mintick) + "\nTP " + str.tostring(targetShort, format.mintick),
         style = label.style_label_down, color = color.new(color.red, 20), textcolor = color.white, size = size.small)

// ---------------- Stats table ----------------
var table statsTable = table.new(position.top_right, 2, 7, border_width = 1)
if barstate.islast
    table.cell(statsTable, 0, 0, "Session Pullback System", bgcolor = color.gray, text_color = color.white)
    table.cell(statsTable, 1, 0, "", bgcolor = color.gray)
    table.cell(statsTable, 0, 1, "4H Bias")
    table.cell(statsTable, 1, 1, biasLabel, text_color = biasBullish ? color.green : biasBearish ? color.red : color.gray)
    table.cell(statsTable, 0, 2, "ATR% (percentile)")
    table.cell(statsTable, 1, 2, str.tostring(atrPct, "#.##") + "% (" + str.tostring(volPercentile, "#.#") + "ile)")
    table.cell(statsTable, 0, 3, "Vol Filter")
    table.cell(statsTable, 1, 3, volOk ? "OK" : "BLOCKED", text_color = volOk ? color.green : color.red)
    table.cell(statsTable, 0, 4, "Block Time Left")
    table.cell(statsTable, 1, 4, str.tostring(minutesLeft) + " min", text_color = noTradeWindow ? color.orange : color.gray)
    table.cell(statsTable, 0, 5, "No-Entry Window")
    table.cell(statsTable, 1, 5, noTradeWindow ? "YES (skip)" : "no")
    table.cell(statsTable, 0, 6, "Signals This Block")
    table.cell(statsTable, 1, 6, str.tostring(signalsThisBlock))

alertcondition(longTrigger, title = "SPS Long Trigger", message = "Session Pullback System: LONG setup triggered")
alertcondition(shortTrigger, title = "SPS Short Trigger", message = "Session Pullback System: SHORT setup triggered")
alertcondition(newBlock, title = "SPS New Session Block", message = "Session Pullback System: new 4h session block started - flatten/reassess")
